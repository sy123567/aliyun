@startuml
class User {
  - id: String
  - name: String
  - password: String
  - role: String
  + login(username: String, password: String): boolean
  + changePassword(oldPwd: String, newPwd: String): boolean
}

class Classroom {
  - id: String
  - name: String
  - location: String
  - capacity: int
  - status: String
  + getAvailableTimeSlots(date: Date): List
}

class TimeSlot {
  - id: String
  - startTime: DateTime
  - endTime: DateTime
  - isAvailable: boolean
}

class Reservation {
  - id: String
  - userId: String
  - classroomId: String
  - timeSlot: TimeSlot
  - status: String
  - createTime: DateTime
}

class AdminService {
  + addUser(user: User): void
  + deleteUser(userId: String): void
  + addClassroom(classroom: Classroom): void
  + deleteClassroom(classroomId: String): void
  + setTimeSlots(classroomId: String, slots: List): void
  + viewReservations(): List
}

class ReservationService {
  + browseAvailableClassrooms(date: Date): List
  + selectClassroom(classroomId: String): Classroom
  + selectTimeSlot(classroomId: String, slot: TimeSlot): boolean
  + makeReservation(userId: String, classroomId: String, slot: TimeSlot): Reservation
}

class System {
  + authenticate(username: String, password: String): User
}

User --> Reservation
Classroom --> TimeSlot
Classroom --> Reservation
TimeSlot --> Reservation
@enduml